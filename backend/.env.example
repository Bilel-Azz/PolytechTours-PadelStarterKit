# Server Configuration
PORT=8000

# Database Configuration
# Pour SQLite (développement local - par défaut)
# Laisser DATABASE_URL vide ou commenté pour utiliser SQLite

# Pour Neon Postgres (production)
# Décommentez et ajoutez votre connection string Neon :
# DATABASE_URL=postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/database?sslmode=require

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=24h

# Security
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000
